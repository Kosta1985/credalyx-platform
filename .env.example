NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://credalyx:credalyx@localhost:5432/credalyx
PASSPORT_PRICE_MINOR=200
REFERRAL_COMMISSION_MINOR=100
REFERRAL_HOLD_DAYS=30
MIN_PAYOUT_MINOR=2500
PASSPORT_TTL_DAYS=30
SANDBOX_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Issuer signing custody.
# local-pem is development/test only. Production requires PASSPORT_ISSUER_BACKEND=managed.
PASSPORT_ISSUER_BACKEND=local-pem
# For a future KMS/HSM adapter this is an opaque provider key reference/ARN/URI, never raw private key bytes.
# PASSPORT_ISSUER_KEY_REFERENCE=kms://provider/key/version
# Local development/test only; configure both PEM values together or omit both for an ephemeral key.
# PASSPORT_ISSUER_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# PASSPORT_ISSUER_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Owner/API auth: signed JWT from trusted IdP.
# AUTH_JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
AUTH_JWT_ALG=RS256
AUTH_JWT_ISSUER=https://id.example
AUTH_JWT_AUDIENCE=credalyx-api
